# Keep secrets in the server deployment environment or this ignored local .env file.
MONGODB_URI=
JWT_SECRET=
AUTH_CHALLENGE_SECRET=
PORT=5000

# Gmail SMTP (use a Google App Password, never the mailbox password)
SMTP_EMAIL=
SMTP_APP_PASSWORD=

# Google OAuth; comma-separated client IDs from the Web, Android, and iOS clients.
GOOGLE_ALLOWED_CLIENT_IDS=

# Facebook Login
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v23.0

# Media storage: use "s3" to upload Topline media to the configured S3 bucket.
# The bucket must allow public reads for generated media URLs to play in the app.
STORAGE_PROVIDER=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Firebase Cloud Messaging HTTP v1 service account (required for Android push delivery)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
